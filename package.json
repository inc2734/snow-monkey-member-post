{
	"engines": {
		"node": "^22.11.0 || ^24.11.0 || >=26.0.0",
		"npm": ">=10.2.3"
	},
	"volta": {
		"node": "24.18.0",
		"npm": "12.0.2"
	},
	"author": "inc2734",
	"license": "GPL-2.0+",
	"devDependencies": {
		"@wordpress/browserslist-config": "^6.53.0",
		"@wordpress/env": "11.13.0",
		"@wordpress/scripts": "^34.1.0",
		"autoprefixer": "^10.5.4",
		"cssnano": "^8.0.6",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.26",
		"postcss-cli": "^11.0.1",
		"prettier": "npm:wp-prettier@3.0.3",
		"rimraf": "^6.1.3",
		"sass": "^1.102.0",
		"sass-basis": "^20.0.1"
	},
	"scripts": {
		"export:wp-content:themes": "npm run cli cp -- -r ../../themes .export/wp-content",
		"export:wp-content:uploads": "npm run cli cp -- -r ../../uploads .export/wp-content",
		"export:wp-content": "npm run cli rm -- -rf .export/wp-content && mkdir -p .export/wp-content/uploads && run-p export:wp-content:*",
		"export:db": "mkdir -p .export/sql && npm run wp db -- export .export/sql/local.sql",
		"export": "run-p export:*",
		"import:wp-content:themes": "npm run cli cp -- -r .export/wp-content/themes ../../",
		"import:wp-content:uploads": "npm run cli cp -- -r .export/wp-content/uploads ../../",
		"import:wp-content": "run-p import:wp-content:*",
		"import:db": "npm run wp db -- import .export/sql/local.sql",
		"import": "run-p import:*",
		"wp-env": "wp-env",
		"start": "wp-env start && open http://localhost:8888",
		"stop": "npm run export && wp-env stop",
		"destroy": "wp-env destroy && wp-env destroy --config=.wp-env.tests.json",
		"cli": "wp-env run cli --env-cwd=\"wp-content/plugins/snow-monkey-member-post\"",
		"wp": "wp-env run cli --env-cwd=\"wp-content/plugins/snow-monkey-member-post\" wp",
		"composer": "wp-env run cli --env-cwd=\"wp-content/plugins/snow-monkey-member-post\" composer",
		"test:php:start": "wp-env start --config=.wp-env.tests.json",
		"test:php:stop": "wp-env stop --config=.wp-env.tests.json",
		"test-composer": "wp-env run --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/snow-monkey-member-post\" cli composer",
		"test:lint:js": "wp-scripts lint-js src",
		"pretest:php:lint": "npm run test:php:start && npm run test-composer install -- --no-interaction",
		"test:php:lint": "npm run test-composer lint",
		"posttest:php:lint": "npm run test:php:stop",
		"test:lint:php": "npm run test:php:lint",
		"test:lint": "run-s test:lint:*",
		"pretest:php:unit": "npm run test:php:start && npm run test-composer install -- --no-interaction && npm run test-composer install-theme",
		"test:php:unit": "wp-env run --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/snow-monkey-member-post\" wordpress vendor/bin/phpunit -c .phpunit.xml.dist --verbose",
		"posttest:php:unit": "npm run test:php:stop",
		"test:unit:php": "npm run test:php:unit",
		"test:unit": "run-s test:unit:*",
		"test": "run-s test:lint test:unit",
		"format:js": "wp-scripts format src/extension",
		"format": "run-p format:*",
		"clean:js": "rimraf dist/js",
		"clean:css": "rimraf dist/css",
		"css": "npm run clean:css && sass --no-source-map src/css:dist/css && postcss dist/css/*.css -r",
		"js:editor-extension": "wp-scripts build src/js/editor-extension.js --output-path dist/js",
		"js": "npm run clean:js && npm run format && run-p js:*",
		"build": "run-p css js",
		"clean:zip": "rimraf snow-monkey-member-post.zip",
		"zip:pack": "rsync -a --exclude='/vendor' --exclude='/node_modules' --exclude='.*' --exclude='*.ruleset.xml' --exclude='*.config.*' --exclude='*.xml.dist' --exclude='/sql' --exclude='/tests'  --exclude='/uploas' --exclude='package*.json' . snow-monkey-member-post && wp-env start && npm run composer install -- --no-dev -d snow-monkey-member-post",
		"zip:archive": "zip -9 -qmr snow-monkey-member-post.zip snow-monkey-member-post",
		"zip": "npm run clean:zip && npm run zip:pack && npm run zip:archive",
		"make-pot": "npm run wp i18n -- make-pot . ./languages/snow-monkey-member-post.pot --exclude=src",
		"make-json": "rimraf languages/*.json && npm run wp i18n -- make-json ./languages/snow-monkey-member-post-ja.po --no-purge",
		"make-php": "npm run cli php -- ./bin/l10n.php"
	}
}
